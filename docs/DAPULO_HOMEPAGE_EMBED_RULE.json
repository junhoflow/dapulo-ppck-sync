{
  "description": "PPCK: permit owner GitHub Pages to embed Korean and English public Dapulo homepages",
  "expression": "(http.host eq \"dapulo.com\" and http.request.uri.path in {\"/\" \"/en\" \"/en/\"})",
  "action": "rewrite",
  "action_parameters": {
    "headers": {
      "content-security-policy": {
        "operation": "set",
        "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://junhoflow.github.io"
      },
      "x-frame-options": {
        "operation": "remove"
      }
    }
  },
  "enabled": true
}
